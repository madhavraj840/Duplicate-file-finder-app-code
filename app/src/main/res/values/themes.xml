<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Light theme; values-night/ flips the tokens for dark (DESIGN §5). -->
    <style name="Base.Theme.DuplicateFileFinder" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="colorSurface">@color/card_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/danger</item>
        <!-- Edge-to-edge: bars are transparent and MainActivity consumes insets at the
             activity root (activity_main.xml fitsSystemWindows="true"). The root's
             @color/surface background fills the status/nav bar areas uniformly. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.DuplicateFileFinder" parent="Base.Theme.DuplicateFileFinder" />

    <!-- Onboarding's dark status bar is applied per-destination in MainActivity
         (single-activity app; a fragment can't carry its own theme). -->

    <!-- Text appearances (DESIGN §1.2) -->
    <style name="Text.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="Text.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Secondary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Buttons (DESIGN §1.3): 56dp, radius 16dp, full width -->
    <style name="Widget.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">56dp</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Danger" parent="Widget.Primary">
        <item name="backgroundTint">@color/danger</item>
    </style>

    <!-- StatTriplet building blocks (DESIGN §3.3) -->
    <style name="StatColumn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="StatDivider">
        <item name="android:layout_width">1dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:background">@color/card_stroke</item>
    </style>

    <!-- 2x2 stat grid cell (DESIGN §3.5) -->
    <style name="StatCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_rounded_16</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="PremiumFeature">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawableStart">@drawable/ic_check_circle</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:paddingVertical">9dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SortChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.Ghost" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_height">56dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
    </style>
</resources>
