<?xml version="1.0" encoding="utf-8"?>
<!-- Restrained palette (DESIGN_RULES.md §5): one accent, neutral surfaces and text,
     and semantic colors only where they carry meaning (destructive / warning).
     values-night/colors.xml redefines the same names for dark mode. -->
<resources>
    <color name="white">#FFFFFFFF</color>

    <!-- Accent: interactive elements and the selected state only. -->
    <color name="primary">#2A85FF</color>
    <color name="on_primary">#FFFFFF</color>

    <color name="background">#F6F7F9</color>
    <!-- Subtle fill for bars (bottom action bar, thumbnails placeholder). -->
    <color name="surface_variant">#E8EBF0</color>
    <color name="divider">#D6DBE3</color>

    <color name="text_primary">#1A1E24</color>
    <color name="text_secondary">#626B75</color>

    <color name="danger">#E0383E</color>
    <color name="warning">#C98A2E</color>
</resources>
