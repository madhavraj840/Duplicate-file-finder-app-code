<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark theme: the color names flip via values-night/colors.xml; this file only
         swaps the Material base to Dark and the system-bar icon tint. Keep the items
         in sync with values/themes.xml. -->
    <style name="Base.Theme.DuplicateFileFinder" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/background</item>
        <item name="colorSurfaceContainer">@color/surface_variant</item>
        <item name="colorSurfaceContainerHigh">@color/surface_variant</item>
        <item name="colorSurfaceContainerHighest">@color/surface_variant</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="colorError">@color/danger</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="materialButtonStyle">@style/Button</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Dialog</item>
        <item name="checkboxStyle">@style/CheckBox</item>
        <item name="radioButtonStyle">@style/RadioButton</item>
    </style>

    <style name="Theme.DuplicateFileFinder" parent="Base.Theme.DuplicateFileFinder" />
</resources>
