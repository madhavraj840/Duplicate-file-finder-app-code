<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark theme: the color tokens flip via values-night/colors.xml; this file
         only swaps the Material base to Dark and the system-bar icon tint. -->
    <style name="Base.Theme.DuplicateFileFinder" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/primary_dark</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="colorSurface">@color/card_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/danger</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.DuplicateFileFinder" parent="Base.Theme.DuplicateFileFinder" />
</resources>
