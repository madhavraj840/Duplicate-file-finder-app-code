<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:padding="16dp">

    <ImageView
        android:id="@+id/backButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="10dp"
        android:src="@drawable/ic_back"
        android:contentDescription="@string/cd_back"
        app:layout_constraintBottom_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/title" />

    <TextView
        android:id="@+id/title"
        style="@style/Text.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/review_delete_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Will be deleted -->
    <LinearLayout
        android:id="@+id/deletedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_rounded_16"
        android:backgroundTint="@color/danger_container"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="18dp"
        app:layout_constraintTop_toBottomOf="@id/title">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_rounded_12"
            android:backgroundTint="#33E5484D">

            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:src="@drawable/ic_trash" app:tint="@color/danger" android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/will_be_deleted" android:textColor="@color/danger" android:textSize="16sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/deletedSize" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/danger" android:textSize="24sp" android:textStyle="bold" tools:text="1.78 GB" />
                    <TextView style="@style/Text.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/total_size" />
                </LinearLayout>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#26E5484D" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp">
                    <TextView android:id="@+id/deletedCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/danger" android:textSize="24sp" android:textStyle="bold" tools:text="1,234" />
                    <TextView style="@style/Text.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/files_word" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Will be kept -->
    <LinearLayout
        android:id="@+id/keptBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_rounded_16"
        android:backgroundTint="@color/success_container"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="18dp"
        app:layout_constraintTop_toBottomOf="@id/deletedBox">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_rounded_12"
            android:backgroundTint="#3322A356">

            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:layout_gravity="center" android:src="@drawable/ic_save" app:tint="@color/success" android:contentDescription="@null" />
        </FrameLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/will_be_kept" android:textColor="@color/success" android:textSize="16sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/keptSize" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/success" android:textSize="24sp" android:textStyle="bold" tools:text="3.42 GB" />
                    <TextView style="@style/Text.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/total_size" />
                </LinearLayout>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#2622A356" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="14dp">
                    <TextView android:id="@+id/keptCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/success" android:textSize="24sp" android:textStyle="bold" tools:text="2,560" />
                    <TextView style="@style/Text.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/files_word" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Warning banner -->
    <LinearLayout
        android:id="@+id/banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_rounded_16"
        android:backgroundTint="@color/warning_container"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/keptBox">

        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_warning" android:contentDescription="@null" />
        <TextView android:id="@+id/bannerText" style="@style/Text.Secondary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="@string/bin_recover_note" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/proceedButton"
        style="@style/Widget.Danger"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        app:icon="@drawable/ic_trash"
        app:iconGravity="textStart"
        app:iconTint="@color/white"
        android:text="@string/proceed_to_delete"
        app:layout_constraintBottom_toTopOf="@id/reviewAgainButton" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/reviewAgainButton"
        style="@style/Widget.Ghost"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        app:strokeColor="@color/danger"
        android:textColor="@color/danger"
        android:text="@string/review_again"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
