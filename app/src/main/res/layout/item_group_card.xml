<?xml version="1.0" encoding="utf-8"?>
<!-- One duplicate group: a list row, not a card. Tapping the row opens the copies;
     the checkbox marks every copy except the recommended one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/groupCheck"
            android:layout_width="48dp"
            android:layout_height="48dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/groupTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textAppearance="@style/Text.Body" />

            <TextView
                android:id="@+id/groupSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Text.Secondary" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/thumbRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="56dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/thumb0"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@color/surface_variant"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/Shape.Thumb" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/thumb1"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="4dp"
            android:background="@color/surface_variant"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/Shape.Thumb" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/thumb2"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="4dp"
            android:background="@color/surface_variant"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/Shape.Thumb" />

        <TextView
            android:id="@+id/moreCount"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:textAppearance="@style/Text.Secondary" />
    </LinearLayout>
</LinearLayout>
