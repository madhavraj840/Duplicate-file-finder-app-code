<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same exclusions as backup_rules.xml (see the note there). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="last_scan.json" />
        <exclude domain="file" path="bin_index.json" />
        <exclude domain="file" path="bin_journal.jsonl" />
        <exclude domain="file" path="datastore/duplicate_finder_prefs.preferences_pb" />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="last_scan.json" />
        <exclude domain="file" path="bin_index.json" />
        <exclude domain="file" path="bin_journal.jsonl" />
        <exclude domain="file" path="datastore/duplicate_finder_prefs.preferences_pb" />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
