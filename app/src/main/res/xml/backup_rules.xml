<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below. Scan results and the recycle-bin index describe files on
     THIS device, and the premium flag must come from the store, not a backup:
     restoring any of them onto another phone creates ghost entries. -->
<full-backup-content>
    <exclude domain="file" path="last_scan.json" />
    <exclude domain="file" path="bin_index.json" />
    <exclude domain="file" path="bin_journal.jsonl" />
    <exclude domain="file" path="datastore/duplicate_finder_prefs.preferences_pb" />
    <exclude domain="external" path="." />
</full-backup-content>
